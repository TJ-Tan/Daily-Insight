# GNews API key (required). Get one at https://gnews.io/register
GNEWS_API_KEY=

# Telegram: create a bot with @BotFather, then get your chat ID (e.g. from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheet: create a sheet, share it with the service account email (Editor), use Sheet ID from URL
GOOGLE_SHEET_ID=
# Service account JSON as a single line (or use Vercel env and paste the whole JSON)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: OpenAI API key for AI summarization. If omitted, article description is used as summary.
OPENAI_API_KEY=

# Optional: set a secret and Vercel will send it as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
